{
  "expo": {
    "name": "Langsphere",
    "slug": "nri-language-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nrilanguageplatform",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1E1E",
        "foregroundImage": "./assets/images/langsphere_logo_padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ciel.ai.nrilanguageplatform"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "NRI Kids!",
      "shortName": "NRI Kids",
      "description": "Learn your heritage language with NRI Kids! Fun lessons for Tamil, Hindi, Telugu, Malayalam & Kannada.",
      "themeColor": "#22C55E",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d20388e4-77ce-4f7b-a390-4b76b6bbcde0"
      }
    }
  }
}
